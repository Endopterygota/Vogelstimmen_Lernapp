{
  "name": "vogelstimmen-lernapp",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.2",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.2",
    "test": "vitest run",
    "test:ui": "node scripts/smoke-test.mjs",
    "test:updates": "node scripts/update-smoke-test.mjs",
    "format": "prettier --write src scripts/*.mjs *.ts *.json *.html .github/workflows/*.yml README.md",
    "android:sync": "pnpm build && cap sync android",
    "android:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@fontsource/manrope": "^5.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "1.58.2",
    "prettier": "3.7.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
